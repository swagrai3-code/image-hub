# INCLUDE < sevoh >
// pin configuration 
constint trig pin =9;
const int echo pin = 10;
servo sevromotor;
// variablesam
long duration
int distance ;
void setup () }
// initialize pins 
pin mode (trig pin,output);
pin mode (echopin,Input)
// Attach servo
servo motor attach (3); // sevro 
// start with lid closed
servoMotor write (0); }

void loop () {
  // send ultra sonic pulse
  digital write (trig pin Low)
  delay micro seconds (2);
  digital write (trig pin,PIGH)
  delay micro second (10);
  digital write (trig pin,Low);
  // Read echo
  duration=pluse In echo pin,High
  distance= duration *0.034/2;// covert to cm
  serial print In (distance)
  IF (distance=20/{)
  servomotor write (90);// open lid
  delay (5000);//keep open
  servo motor write (0); //close lid
}}
  